            "date": 1729999653725,
            "name": "Commit-0",
            "content": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Ryan Pemberton - Audio Portfolio</title>\r\n    <style>\r\n        /* Reset and base styles */\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        body {\r\n            font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;\r\n            line-height: 1.5;\r\n            color: #333;\r\n        }\r\n\r\n        /* Grid layout */\r\n        .portfolio-grid {\r\n            display: grid;\r\n            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\r\n            gap: 1rem;\r\n            padding: 1rem;\r\n            max-width: 1200px;\r\n            margin: 0 auto;\r\n        }\r\n\r\n        .portfolio-item {\r\n            aspect-ratio: 1;\r\n            cursor: pointer;\r\n            transition: transform 0.2s;\r\n            border-radius: 8px;\r\n            overflow: hidden;\r\n            background: #f1f5f9;\r\n        }\r\n\r\n        .portfolio-item:hover {\r\n            transform: scale(1.05);\r\n        }\r\n\r\n        .portfolio-item img {\r\n            width: 100%;\r\n            height: 100%;\r\n            object-fit: cover;\r\n        }\r\n\r\n        /* Modal */\r\n        .modal {\r\n            display: none;\r\n            position: fixed;\r\n            top: 0;\r\n            left: 0;\r\n            right: 0;\r\n            bottom: 0;\r\n            background: rgba(0, 0, 0, 0.7);\r\n            z-index: 1000;\r\n            padding: 1rem;\r\n        }\r\n\r\n        .modal.active {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n        }\r\n\r\n        .modal-content {\r\n            background: white;\r\n            padding: 1.5rem;\r\n            border-radius: 8px;\r\n            max-width: 600px;\r\n            width: 100%;\r\n            max-height: 90vh;\r\n            overflow-y: auto;\r\n        }\r\n\r\n        .modal-header {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            margin-bottom: 1rem;\r\n        }\r\n\r\n        .close-button {\r\n            background: none;\r\n            border: none;\r\n            cursor: pointer;\r\n            font-size: 1.5rem;\r\n            padding: 0.5rem;\r\n        }\r\n\r\n        .modal-body {\r\n            display: grid;\r\n            grid-template-columns: 120px 1fr;\r\n            gap: 1.5rem;\r\n        }\r\n\r\n        .modal-artwork {\r\n            width: 120px;\r\n            height: 120px;\r\n            border-radius: 4px;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .modal-artwork img {\r\n            width: 100%;\r\n            height: 100%;\r\n            object-fit: cover;\r\n        }\r\n\r\n        .modal-details h3 {\r\n            color: #666;\r\n            font-size: 0.875rem;\r\n            margin-bottom: 0.25rem;\r\n        }\r\n\r\n        .modal-details p {\r\n            margin-bottom: 1rem;\r\n        }\r\n\r\n        .links {\r\n            display: flex;\r\n            gap: 1rem;\r\n            margin-top: 1rem;\r\n        }\r\n\r\n        .links a {\r\n            color: #2563eb;\r\n            text-decoration: none;\r\n            font-size: 0.875rem;\r\n        }\r\n\r\n        .links a:hover {\r\n            text-decoration: underline;\r\n        }\r\n\r\n        @media (max-width: 640px) {\r\n            .portfolio-grid {\r\n                grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));\r\n            }\r\n\r\n            .modal-body {\r\n                grid-template-columns: 1fr;\r\n            }\r\n\r\n            .modal-artwork {\r\n                width: 100px;\r\n                height: 100px;\r\n                margin: 0 auto;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"portfolio-grid\"></div>\r\n\r\n    <!-- Modal template -->\r\n    <div class=\"modal\" id=\"podcastModal\">\r\n        <div class=\"modal-content\">\r\n            <div class=\"modal-header\">\r\n                <h2 class=\"title\"></h2>\r\n                <button class=\"close-button\">&times;</button>\r\n            </div>\r\n            <div class=\"modal-body\">\r\n                <div class=\"modal-artwork\">\r\n                    <img src=\"\" alt=\"\">\r\n                </div>\r\n                <div class=\"modal-details\">\r\n                    <h3>Client</h3>\r\n                    <p class=\"client\"></p>\r\n                    <h3>Role</h3>\r\n                    <p class=\"role\"></p>\r\n                    <h3>About</h3>\r\n                    <p class=\"description\"></p>\r\n                    <div class=\"links\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n</body>\r\n</html>"
        }
    ]
